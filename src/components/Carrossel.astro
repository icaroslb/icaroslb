---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  imagens: { src: ImageMetadata; legenda?: string }[];
  titulo: string;
}

const { imagens, titulo } = Astro.props;
const varias = imagens.length > 1;
---

{imagens.length > 0 && (
  <section class="carrossel" aria-roledescription="carrossel" aria-label={`Imagens de ${titulo}`}>
    <div class="trilho" tabindex="0">
      {imagens.map((img, i) => (
        <figure class="slide" aria-label={`${i + 1} de ${imagens.length}`}>
          <Image src={img.src} alt={img.legenda ?? `${titulo} — imagem ${i + 1}`} width={800} loading={i === 0 ? 'eager' : 'lazy'} />
          {img.legenda && <figcaption class="muted">{img.legenda}</figcaption>}
        </figure>
      ))}
    </div>
    {varias && (
      <div class="controles">
        <button type="button" class="anterior" aria-label="Imagem anterior">‹</button>
        <div class="pontos">
          {imagens.map((_, i) => (
            <button type="button" class="ponto" aria-label={`Ir para a imagem ${i + 1}`} aria-current={i === 0 ? 'true' : undefined} />
          ))}
        </div>
        <button type="button" class="proxima" aria-label="Próxima imagem">›</button>
      </div>
    )}
  </section>
)}

<script>
  for (const carrossel of document.querySelectorAll<HTMLElement>('.carrossel')) {
    const trilho = carrossel.querySelector<HTMLElement>('.trilho')!;
    const slides = [...trilho.children] as HTMLElement[];
    const pontos = [...carrossel.querySelectorAll<HTMLButtonElement>('.ponto')];
    if (slides.length < 2) continue;

    const atual = () => Math.round(trilho.scrollLeft / trilho.clientWidth);
    const ir = (i: number) => {
      const alvo = (i + slides.length) % slides.length;
      trilho.scrollTo({ left: alvo * trilho.clientWidth, behavior: 'smooth' });
    };

    carrossel.querySelector('.anterior')!.addEventListener('click', () => ir(atual() - 1));
    carrossel.querySelector('.proxima')!.addEventListener('click', () => ir(atual() + 1));
    pontos.forEach((p, i) => p.addEventListener('click', () => ir(i)));
    trilho.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') ir(atual() - 1);
      else if (e.key === 'ArrowRight') ir(atual() + 1);
      else return;
      e.preventDefault();
    });
    trilho.addEventListener('scroll', () => {
      const i = atual();
      pontos.forEach((p, j) => (j === i ? p.setAttribute('aria-current', 'true') : p.removeAttribute('aria-current')));
    });
  }
</script>

<style>
  .carrossel {
    max-width: 36rem;
    margin: 2rem auto;
  }
  .trilho {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--surface);
  }
  .trilho::-webkit-scrollbar {
    display: none;
  }
  .trilho:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .slide {
    flex: 0 0 100%;
    margin: 0;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
  }
  .slide img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: contain;
    height: auto;
  }
  figcaption {
    padding: 0.5rem 0.75rem;
    font-size: 0.9rem;
    text-align: center;
  }
  .controles {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }
  .anterior,
  .proxima {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
  }
  .anterior:hover,
  .proxima:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .pontos {
    display: flex;
    gap: 0.4rem;
  }
  .ponto {
    width: 0.6rem;
    height: 0.6rem;
    padding: 0;
    border-radius: 50%;
    border: none;
    background: var(--border);
    cursor: pointer;
  }
  .ponto[aria-current='true'] {
    background: var(--accent);
  }
</style>
