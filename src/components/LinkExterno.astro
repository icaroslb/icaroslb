---
// Botão para outro site: abre em nova aba, com ícone ↗ e aviso para leitores de tela.
interface Props {
  href: string;
  destaque?: boolean;
}

const { href, destaque = false } = Astro.props;
---

<a class:list={['button', { secondary: !destaque }]} href={href} target="_blank" rel="noopener">
  <slot /><span aria-hidden="true"> ↗</span><span class="sr-only"> (abre em nova aba)</span>
</a>
