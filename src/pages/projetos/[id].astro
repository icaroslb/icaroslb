---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import LinkExterno from '../../components/LinkExterno.astro';
import Carrossel from '../../components/Carrossel.astro';
import { getProjetos } from '../../lib/projetos';

export async function getStaticPaths() {
  const projetos = await getProjetos();
  return projetos.map((projeto) => ({ params: { id: projeto.id }, props: { projeto } }));
}

const { projeto } = Astro.props;
const { titulo, resumo, tipo, ano, tecnologias, papel, equipe, capa, imagens, links } = projeto.data;
const { Content } = await render(projeto);
const galeria = [...(capa ? [{ src: capa }] : []), ...imagens];
---

<Base title={titulo} description={resumo}>
  <p class="muted"><a href="/projetos/">← Projetos</a></p>
  <h1>{titulo}</h1>
  <p class="muted">{tipo === 'jogo' ? 'Jogo' : 'Aplicativo'} · {ano}</p>
  {(papel || equipe.length > 0) && (
    <dl class="creditos">
      {papel && (
        <>
          <dt>Minha função</dt>
          <dd>{papel}</dd>
        </>
      )}
      {equipe.length > 0 && (
        <>
          <dt>Equipe</dt>
          <dd>
            <ul class="equipe">
              {equipe.map((membro) => (
                <li>
                  {membro.nome}
                  {membro.papel && <span class="muted"> — {membro.papel}</span>}
                </li>
              ))}
            </ul>
          </dd>
        </>
      )}
    </dl>
  )}
  <ul class="tags">{tecnologias.map((t) => <li>{t}</li>)}</ul>

  {links.length > 0 && (
    <p class="links">
      {links.map((l) => (
        <LinkExterno href={l.url}>
          {l.rotulo}
        </LinkExterno>
      ))}
    </p>
  )}

  <article>
    <Content />
  </article>

  <Carrossel imagens={galeria} titulo={titulo} />
</Base>

<style>
  h1 {
    margin-bottom: 0;
  }
  .creditos {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25rem 1rem;
    margin: 1rem 0;
  }
  .creditos dt {
    font-weight: 600;
  }
  .creditos dd {
    margin: 0;
  }
  .equipe {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
</style>
